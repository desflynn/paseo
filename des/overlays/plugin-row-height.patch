+    const claimedError = pluginItem("semantic-markdown-load-error", { text: "boom" }, 3);
+    expect(
+      estimateStreamItemHeight({
+        item: claimedError,
+        contentMaxWidth: DEFAULT_CONTENT_MAX_WIDTH,
+      }),
+    ).toBe(
+      estimateStreamItemHeight({
+        item: toolCall("tool", 3),
