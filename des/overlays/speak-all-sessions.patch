+  const message: SessionOutboundMessage = {
+    type: "audio_output",
+    payload: {
+      id: "audio-1:0",
+      groupId: "audio-1",
+      chunkIndex: 0,
+      isLastChunk: true,
+      audio: "AAAA",
+      format: "pcm;rate=24000",
+      isVoiceMode: false,
+    },
